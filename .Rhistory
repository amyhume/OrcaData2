mice_baseline = orca_study_enrollment___4, peach = orca_study_enrollment___5,
reef = orca_study_enrollment___6
)
records <- records %>%
left_join(eligibility, by='record_id') %>%
filter(orca_contact_yesno == 1)
records <- records %>%
select(-orca_contact_yesno)
return(records)
}
}
